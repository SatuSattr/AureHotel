# Copy this file to .env and fill in your own values.
# Real environment variables always take precedence over this file.

# --- Database ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aurehotel
DB_USER=root
DB_PASS=1232

# --- Application ------------------------------------------------------------
APP_TIMEZONE=Asia/Jakarta

# Public frontend URL used for invoice links inside booking emails.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of browser origins allowed to call the API.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional shared key for POST /book.
# BOOKING_API_KEY=

# --- SMTP / email -----------------------------------------------------------
# Leave SMTP_HOST empty to disable email delivery.
MAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# tls = STARTTLS, ssl = implicit TLS, none = plain connection (local mail catchers).
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=10
SMTP_VERIFY_PEER=true
MAIL_FROM_ADDRESS=no-reply@aurehotel.id
MAIL_FROM_NAME=AureHotel
